# Copy to .env for local runs (git-ignored). CI supplies these via GitHub secrets.
#
# Either set a single Infura project key (used for both default RPC URLs)...
INFURA_KEY=your_infura_project_key

# ...or override the full RPC URLs (takes precedence over INFURA_KEY):
# PALM_RPC=https://palm-mainnet.infura.io/v3/xxxxxxxx
# ETHEREUM_RPC=https://mainnet.infura.io/v3/xxxxxxxx
